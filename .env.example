# ---------------------------------------------------------------------------
# Ophir Observability Hub - environment template
# Copy to .env and adjust for your local environment.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# PostgreSQL control-plane database
DATABASE_URL=postgres://ophir:ophir@localhost:5442/ophir

# Admin authentication (JWT sessions)
# Use a long random value in real environments (min 32 chars).
JWT_SECRET=change-me-to-a-long-random-secret-string-min-32-chars
JWT_ISSUER=ophir
JWT_AUDIENCE=ophir-admin
ACCESS_TOKEN_TTL_SECONDS=3600

# Source ingestion credentials
SOURCE_KEY_PREFIX=ophir_src_

# OpenTelemetry Collector - where Ophir forwards accepted telemetry.
# Ophir appends /v1/logs, /v1/traces, /v1/metrics to this base URL.
COLLECTOR_OTLP_HTTP_URL=http://localhost:4318
COLLECTOR_FORWARD_TIMEOUT_MS=5000

# Integration health probe targets
COLLECTOR_URL=http://localhost:13133
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
# Browser-reachable Grafana URL used to build clickable dashboard links.
GRAFANA_PUBLIC_URL=http://localhost:3000
HEALTH_PROBE_INTERVAL_MS=30000
HEALTH_PROBE_TIMEOUT_MS=3000

# Self-observability (Ophir exporting its own telemetry through the Collector)
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=ophir
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Optional bootstrap admin used by `npm run admin:create`
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=local-development-password
BOOTSTRAP_ADMIN_NAME=Local Admin
