# ===========================================================================
# Ophir stack configuration (Docker delivery)
# Copy to infra/.env and fill in real values. infra/.env is gitignored.
# Run:  docker compose --env-file infra/.env -f infra/docker-compose.yml up -d
# ===========================================================================

# --- Image / project -------------------------------------------------------
# Tag to build/push the Ophir API image as (e.g. registry/owner/ophir:1.0.0).
OPHIR_IMAGE=ophir:latest
COMPOSE_PROJECT_NAME=ophir

# Pin third-party images for reproducible deploys (optional).
# POSTGRES_IMAGE=postgres:16-alpine
# LOKI_IMAGE=grafana/loki:3.3.2
# TEMPO_IMAGE=grafana/tempo:2.7.0
# PROMETHEUS_IMAGE=prom/prometheus:v3.1.0
# GRAFANA_IMAGE=grafana/grafana:11.4.0
# OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.117.0

# --- Network exposure ------------------------------------------------------
# Internal services bind to localhost by default (not exposed to the network).
DEBUG_BIND=127.0.0.1
# Ophir ingestion API and Grafana admin UI are meant to be reachable.
OPHIR_BIND=0.0.0.0
OPHIR_PORT=8080
GRAFANA_BIND=0.0.0.0
GRAFANA_PORT=1234
# Host ports for internal services (debugging only; localhost-bound).
POSTGRES_PORT=5442
LOKI_PORT=3100
TEMPO_PORT=3200
PROMETHEUS_PORT=9090
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_PROM_PORT=8889
OTEL_HEALTH_PORT=13133

# --- PostgreSQL (SECRET: change the password) ------------------------------
POSTGRES_USER=ophir
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=ophir
DATABASE_POOL_MAX=10

# --- Ophir admin auth (SECRET: required, >=32 chars) -----------------------
JWT_SECRET=CHANGE_ME_to_a_long_random_secret_at_least_32_characters
JWT_ISSUER=ophir
JWT_AUDIENCE=ophir-admin
ACCESS_TOKEN_TTL_SECONDS=3600

# --- Source ingestion ------------------------------------------------------
SOURCE_KEY_PREFIX=ophir_src_
COLLECTOR_FORWARD_TIMEOUT_MS=5000

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
RUN_MIGRATIONS=true
HEALTH_PROBE_INTERVAL_MS=30000
HEALTH_PROBE_TIMEOUT_MS=3000
HEALTH_PROBE_ENABLED=true

# --- Self-observability ----------------------------------------------------
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=ophir

# --- Grafana admin (SECRET: change the password) ---------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin_password
# Browser-reachable Grafana URL (used for dashboard links + Grafana root_url).
GRAFANA_PUBLIC_URL=http://localhost:1234

# --- Optional bootstrap admin ----------------------------------------------
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_admin_password_min_12
# BOOTSTRAP_ADMIN_NAME=Ophir Admin
