# ===========================================================================
# Ophir ALL-IN-ONE configuration (single-container delivery)
# Copy to .env next to docker-compose.example.yml and fill in real values.
# Run:  docker compose -f docker-compose.example.yml --env-file .env up -d
# ===========================================================================

# --- Image / project -------------------------------------------------------
# The published all-in-one image to pull.
OPHIR_IMAGE=rafaelrueda/ophir:latest
COMPOSE_PROJECT_NAME=ophir

# --- REQUIRED --------------------------------------------------------------
# External PostgreSQL Ophir will use for its control plane (NOT bundled).
DATABASE_URL=postgres://ophir:CHANGE_ME_password@your-db-host:5432/ophir
# Admin auth signing secret (>= 32 chars).
JWT_SECRET=CHANGE_ME_to_a_long_random_secret_at_least_32_characters

# --- Published ports -------------------------------------------------------
OPHIR_PORT=8080
GRAFANA_PORT=1234

# --- Grafana admin (SECRET: change the password) ---------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin_password
# Browser-reachable Grafana URL (used for dashboard deep links).
GRAFANA_PUBLIC_URL=http://localhost:1234

# --- Optional bootstrap admin (auto-created on first boot) ------------------
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_admin_password_min_12
# BOOTSTRAP_ADMIN_NAME=Ophir Admin

# --- Optional tuning -------------------------------------------------------
LOG_LEVEL=info
RUN_MIGRATIONS=true
